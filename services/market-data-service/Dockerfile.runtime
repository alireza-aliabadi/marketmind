# Package an already built, checksum-verified CI artifact without network downloads.
# The runtime image is identical to the full source-build Dockerfile.
FROM chainguard/static@sha256:f68e3a8244c7d0f4cd56635aaff8e6a533cf6cc3850d8fb339567a5782d6a0b0
COPY market-data /market-data
USER 65532:65532
ENTRYPOINT ["/market-data"]
