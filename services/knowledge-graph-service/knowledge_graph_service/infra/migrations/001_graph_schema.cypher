CREATE CONSTRAINT mm_graph_migration_version IF NOT EXISTS FOR (m:GraphSchemaMigration) REQUIRE m.version IS UNIQUE;
CREATE CONSTRAINT mm_company_key IF NOT EXISTS FOR (n:Company) REQUIRE n.key IS UNIQUE;
CREATE CONSTRAINT mm_company_canonical_id IF NOT EXISTS FOR (n:Company) REQUIRE n.canonical_id IS UNIQUE;
CREATE CONSTRAINT mm_instrument_key IF NOT EXISTS FOR (n:Instrument) REQUIRE n.key IS UNIQUE;
CREATE CONSTRAINT mm_instrument_canonical_id IF NOT EXISTS FOR (n:Instrument) REQUIRE n.canonical_id IS UNIQUE;
CREATE CONSTRAINT mm_market_event_key IF NOT EXISTS FOR (n:MarketEvent) REQUIRE n.key IS UNIQUE;
CREATE CONSTRAINT mm_sector_key IF NOT EXISTS FOR (n:Sector) REQUIRE n.key IS UNIQUE;
CREATE CONSTRAINT mm_industry_key IF NOT EXISTS FOR (n:Industry) REQUIRE n.key IS UNIQUE;
CREATE CONSTRAINT mm_product_key IF NOT EXISTS FOR (n:Product) REQUIRE n.key IS UNIQUE;
CREATE CONSTRAINT mm_source_key IF NOT EXISTS FOR (n:Source) REQUIRE n.key IS UNIQUE;
CREATE CONSTRAINT mm_claim_key IF NOT EXISTS FOR (n:Claim) REQUIRE n.key IS UNIQUE;
CREATE INDEX mm_company_name IF NOT EXISTS FOR (n:Company) ON (n.name);
CREATE INDEX mm_instrument_symbol IF NOT EXISTS FOR (n:Instrument) ON (n.ticker, n.exchange);
CREATE INDEX mm_source_provider_id IF NOT EXISTS FOR (n:Source) ON (n.provider, n.external_id);
CREATE INDEX mm_claim_scope_predicate_status IF NOT EXISTS FOR (n:Claim) ON (n.scope, n.predicate, n.status);
CREATE INDEX mm_claim_valid_from IF NOT EXISTS FOR (n:Claim) ON (n.valid_from);
CREATE INDEX mm_claim_valid_to IF NOT EXISTS FOR (n:Claim) ON (n.valid_to);
CREATE INDEX mm_claim_observed_at IF NOT EXISTS FOR (n:Claim) ON (n.observed_at);
CREATE INDEX mm_event_occurred_at IF NOT EXISTS FOR (n:MarketEvent) ON (n.occurred_at);
CREATE INDEX mm_source_published_at IF NOT EXISTS FOR (n:Source) ON (n.published_at);
