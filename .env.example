# MarketMind AI - Environment Configuration Example
# Copy this file to .env and adjust variables as needed for local development.

# Application Settings
APP_NAME=marketmind-api
APP_ENV=local
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# PostgreSQL / TimescaleDB
POSTGRES_DB=marketmind
POSTGRES_USER=marketmind
POSTGRES_PASSWORD=your_postgres_password_here
DATABASE_URL=postgresql+psycopg://marketmind:your_postgres_password_here@localhost:5432/marketmind

# Redis
REDIS_URL=redis://localhost:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Neo4j Knowledge Graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# S3 / MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key_here
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_SECURE=false

# External Providers (Phase 2+)
# SEC EDGAR requires a custom User-Agent in format: Sample Company Name AdminContact@<sample company domain>.com
SEC_EDGAR_USER_AGENT=MarketMindResearch admin@marketmind.local
FRED_API_KEY=your_fred_api_key_here
