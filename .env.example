# MarketMind AI - Environment Configuration Example
# Copy this file to .env and adjust variables as needed for local development.

# Application Settings
APP_NAME=marketmind-api
APP_ENV=local
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Go gateway (export these into its process environment; Go does not load .env)
# PORT above is for the Python sample. Missing OIDC config fails gateway startup.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
DOWNSTREAM_URL=http://127.0.0.1:8000
OIDC_ISSUER_URL=https://your-oidc-issuer.example/realms/marketmind
# API resource audience, distinct from the browser login client ID.
OIDC_AUDIENCE=marketmind-api
OIDC_ALLOW_INSECURE_HTTP=false

# PostgreSQL / TimescaleDB
POSTGRES_DB=marketmind
POSTGRES_USER=marketmind
POSTGRES_PASSWORD=your_postgres_password_here
# Use URL-safe passwords (for example, random hexadecimal values).
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Redis
REDIS_URL=redis://localhost:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Neo4j Knowledge Graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# S3 / MinIO AIStor Object Storage
# These configure the local server's root credentials as well as the application.
# A valid, untracked minio.license file is required beside compose.yml.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=marketmind-local
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_SECURE=false

# External Providers (Phase 2+)
# SEC EDGAR requires a custom User-Agent in format: Sample Company Name AdminContact@<sample company domain>.com
SEC_EDGAR_USER_AGENT=MarketMindResearch admin@marketmind.local
FRED_API_KEY=your_fred_api_key_here
